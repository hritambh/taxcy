{
  "name": "@taxcy/workers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,workers -c blue,magenta \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --env-file-if-exists=../../.env --enable-source-maps --watch dist/main.js\"",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/express": "^5",
    "@types/node": "~24.19.1",
    "concurrently": "^10.0.6"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.4",
    "@bull-board/express": "^9.10.4",
    "@taxcy/api": "workspace:*",
    "bullmq": "^6.3.12",
    "express": "^5",
    "nestjs-pino": "^5.3.1"
  }
}
