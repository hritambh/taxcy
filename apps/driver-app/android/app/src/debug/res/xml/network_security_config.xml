<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: allow plain HTTP to any host, so `flutter run` on a physical
  phone can reach the API and RustFS on a laptop's LAN IP (e.g. http://192.168.1.23:3000).
  Release builds use src/main/res/xml/network_security_config.xml.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
