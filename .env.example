# Local development defaults. Copy to .env; nothing here is a real secret.
# Host ports avoid 5432/6379 so a natively installed Postgres or Redis cannot shadow these.
# The API's typed config (M0.2) adds the remaining variables listed in docs/development.md.

POSTGRES_USER=taxcy
POSTGRES_PASSWORD=taxcy
POSTGRES_DB=taxcy
POSTGRES_PORT=5433
# The API connects as taxcy_api (row-level security applies); migrations and seeds use the owner.
DATABASE_URL=postgres://taxcy_api:taxcy_api@localhost:5433/taxcy
DATABASE_MIGRATION_URL=postgres://taxcy:taxcy@localhost:5433/taxcy
# Throwaway database used by `bun run db:drift`.
SHADOW_DATABASE_URL=postgres://taxcy:taxcy@localhost:5433/taxcy_shadow

REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

S3_ENDPOINT=http://localhost:9000
# Host used in signed upload URLs; set to your LAN IP when testing on a physical phone.
S3_PUBLIC_ENDPOINT=
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_REGION=ap-south-1
S3_BUCKET=taxcy-media
S3_ACCESS_KEY_ID=taxcy
S3_SECRET_ACCESS_KEY=taxcy-dev-secret

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

# Dev-only value. Production must use a long random secret from a secret manager.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_IP_LIMIT_PER_HOUR=30
SMS_PROVIDER=console
OCR_PROVIDER=stub

# Sentry is disabled when empty.
SENTRY_DSN=
